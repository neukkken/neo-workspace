{
  "appId": "com.neowork.app",
  "productName": "NeoWork",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "out/**/*",
    "package.json",
    "build/**/*"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node-pty/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NeoWork"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "maintainer": "NeoWork Contributors <contact@neowork.dev>",
    "syncDesktopName": true,
    "category": "Development",
    "icon": "build/icon.png"
  }
}
